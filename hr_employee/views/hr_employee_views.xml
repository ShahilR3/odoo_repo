<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_employee_form_inherit_hidden_menus" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hidden.menus</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="onboard,Offboard"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
