<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="leave_mail_template" model="mail.template">
        <field name="name">Leave Template</field>
        <field name="model_id" ref="model_hr_leave_allocation"/>
        <field name="email_from">{{ object.employee_id.work_email }}</field>
        <field name="email_to">{{ object.user_id.work_email }}</field>
        <field name="subject">Regarding your Leave</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear Employee,
                    <br/>
                    <br/>
                    This is to inform you that you have Pending Leave for this month!
                    <br/>
                    <br/>
                    Yours Sincerely,
                    Admin
                    <br/>
                    <br/>
                </p>
            </div>
        </field>
    </record>
</odoo>