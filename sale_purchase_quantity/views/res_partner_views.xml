<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.inherit.name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <group>
                    <field name="product_id"/>
                    <field name="qty"/>
                    <field name="uom_id"/>
                    <field name="target_uom_id"/>
                    <field name="computed"/>
                </group>
            </xpath>
            <xpath expr="//notebook[@id='path']" position="inside">
                <page string="Other info">
                    <group>
                        <field name="sale_quantity"/>
                        <field name="purchase_quantity"/>
                        <field name="tax_ids" widget="many2many_tax_tags"/>
                        <field name="price"/>
                        <field name="tax_price"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//notebook[@id='path']" position="inside">
                <page string="Sale Order Line" invisibe="not product_id">
                    <field name="sale_order_line_ids"/>
                </page>
            </xpath>
            <xpath expr="//notebook[@id='path']" position="inside">
                <page string="Purchase Order Line" invisibe="not product_id">
                    <field name="purchase_order_line_ids"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>